generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  WORKER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id               String    @id @default(cuid())
  clerkUserId      String    @unique
  email            String    @unique
  status           UserStatus @default(ACTIVE)
  role             UserRole?
  username         String?
  city             String?
  workRadiusKm     Int?
  latitude         Float?
  longitude        Float?
  address         String?
  onboardingDone   Boolean   @default(false)
  phoneNumber      String?   

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdJobs      Job[]     @relation("ClientJobs")
  assignedJobs     Job[]     @relation("AssignedWorkerJobs")

  payoutDetails WorkerPayoutDetails?

  averageRating Float?
  ratingsCount  Int    @default(0)

  sentMessages Message[]

  clientConversations Conversation[] @relation("ClientConversations")
  workerConversations Conversation[] @relation("WorkerConversations")
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id               String     @id @default(cuid())
  title            String
  description      String
  price            Decimal    @db.Decimal(10, 2)

  city             String
  address          String
  latitude         Float?
  longitude        Float?
  placeId          String?
  category         String

  status           JobStatus  @default(OPEN)

  clientId         String
  client           User       @relation("ClientJobs", fields: [clientId], references: [id])

  assignedWorkerId String?
  assignedWorker   User?      @relation("AssignedWorkerJobs", fields: [assignedWorkerId], references: [id])

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  imageIds         JobImage[]

  ratings   Rating[]

  conversation Conversation?
}

model JobImage {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  key       String
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model WorkerPayoutDetails {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  details   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rating {
  id        String   @id @default(uuid())

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])

  fromUserId String
  toUserId   String

  value     Int      // 1–5
  comment   String?

  createdAt DateTime @default(now())

  @@unique([jobId, fromUserId])
}

model Conversation {
  id        String   @id @default(uuid())
  jobId     String   @unique
  clientId  String
  workerId  String

  job       Job      @relation(fields: [jobId], references: [id])
  client    User     @relation("ClientConversations", fields: [clientId], references: [id])
  worker    User     @relation("WorkerConversations", fields: [workerId], references: [id])

  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  readAt         DateTime?
  createdAt      DateTime @default(now())
}